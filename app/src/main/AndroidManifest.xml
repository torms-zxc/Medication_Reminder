<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Push Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact and standard alarms for timely medication reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Alarm sound and vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Reschedule alarms on device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Main Launcher & Splash Router -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- User Authentication Activity (SQLite Database 1) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Homepage (Medication Schedules & Actions) -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- Add & Edit Medication Schedule -->
        <activity
            android:name=".AddEditMedicationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Administration History Logs (SQLite Database 2) -->
        <activity
            android:name=".HistoryLogsActivity"
            android:exported="false" />

        <!-- Receivers for Alarms, Notification Actions, and Reboot -->
        <receiver
            android:name=".receiver.MedicationAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
